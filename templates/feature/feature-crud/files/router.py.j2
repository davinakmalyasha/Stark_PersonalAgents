"""Router for {{ feature_name }} CRUD — admin-ready: paginated searchable list, proper status codes."""
from fastapi import APIRouter, Depends, HTTPException, Query, Response, status
from sqlalchemy.orm import Session

from ..database import get_db
from ..schemas.{{ feature_name|lower }} import (
    {{ feature_name }}Create,
    {{ feature_name }}ListResponse,
    {{ feature_name }}Read,
    {{ feature_name }}Update,
)
from ..services.{{ feature_name|lower }}_service import (
    create_{{ feature_name|lower }},
    delete_{{ feature_name|lower }},
    get_{{ feature_name|lower }},
    list_{{ feature_name|lower }},
    update_{{ feature_name|lower }},
)

router = APIRouter(prefix="{{ base_path }}/{{ feature_name|lower }}s", tags=["{{ feature_name }}"])


@router.post("", response_model={{ feature_name }}Read, status_code=status.HTTP_201_CREATED)
def create(data: {{ feature_name }}Create, db: Session = Depends(get_db)):
    return create_{{ feature_name|lower }}(db, data)


@router.get("", response_model={{ feature_name }}ListResponse)
def list_all(page: int = Query(1, ge=1), page_size: int = Query(20, ge=1, le=100),
             search: str = "", sort: str = "", db: Session = Depends(get_db)):
    """Paginated list: ?page=&page_size=&search=&sort=field:asc|desc."""
    items, total = list_{{ feature_name|lower }}(db, page=page, page_size=page_size,
                                                 search=search, sort=sort)
    return {"items": items, "total": total, "page": page, "page_size": page_size}


@router.get("/{item_id}", response_model={{ feature_name }}Read)
def get_one(item_id: int, db: Session = Depends(get_db)):
    item = get_{{ feature_name|lower }}(db, item_id)
    if not item:
        raise HTTPException(status_code=404, detail="{{ feature_name }} not found")
    return item


@router.put("/{item_id}", response_model={{ feature_name }}Read)
def update(item_id: int, data: {{ feature_name }}Update, db: Session = Depends(get_db)):
    return update_{{ feature_name|lower }}(db, item_id, data)


@router.delete("/{item_id}", status_code=status.HTTP_204_NO_CONTENT)
def delete(item_id: int, db: Session = Depends(get_db)) -> Response:
    delete_{{ feature_name|lower }}(db, item_id)
    return Response(status_code=status.HTTP_204_NO_CONTENT)


