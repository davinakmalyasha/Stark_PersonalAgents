{
  "name": "pyproject",
  "description": "pyproject.toml baseline: project metadata, build backend, pytest config.",
  "category": "routine",
  "variables": [
    {"name": "project_name", "type": "string", "required": true, "description": "Project name, e.g. 'my-api'"},
    {"name": "version", "type": "string", "default": "0.1.0", "description": "Initial version"},
    {"name": "python_requires", "type": "string", "default": ">=3.10", "description": "Python version requirement"}
  ],
  "files": [
    {"src": "pyproject.toml.j2", "dest": "pyproject.toml"}
  ],
  "notes": "pip install -e . after creation makes the project importable in development. Add dependencies to [project.dependencies].",
  "sample_vars": {"project_name": "my-api", "version": "0.1.0", "python_requires": ">=3.10"}
}
