"""CSV export helpers — stream any list-of-dicts to file or string."""
import csv
import io
from typing import Any, Dict, Iterable, List


def export_csv(rows: Iterable[Dict[str, Any]], path: str) -> int:
    """Write rows to a UTF-8 CSV file (BOM included for Excel). Returns row count."""
    text = to_csv_string(rows)
    with open(path, "w", encoding="utf-8-sig", newline="") as f:
        f.write(text)
    return text.count("\n")


def to_csv_string(rows: Iterable[Dict[str, Any]]) -> str:
    """Convert list-of-dicts to CSV text. Column order follows the first row."""
    rows = list(rows)
    if not rows:
        return ""
    columns = list(rows[0].keys())
    buf = io.StringIO()
    writer = csv.DictWriter(buf, fieldnames=columns, extrasaction="ignore")
    writer.writeheader()
    for row in rows:
        writer.writerow({k: (v if v is not None else "") for k, v in row.items()})
    return buf.getvalue()
