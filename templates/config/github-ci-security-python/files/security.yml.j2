name: Security Gate

permissions:
  contents: read

on:
  push:
  pull_request:

concurrency:
  group: gate
  cancel-in-progress: true

jobs:
  sast:
    name: sast
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
        with:
          python-version: '{{ python_version }}'
      - name: Bandit (SAST) — fail on HIGH
        run: |
          pip install --quiet bandit
          bandit -r . -lll -q

  sca:
    name: sca
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
        with:
          python-version: '{{ python_version }}'
      - name: pip-audit (SCA) — fail on known CVEs
        run: |
          pip install --quiet pip-audit
          if [ -f requirements.txt ]; then
            pip-audit -r requirements.txt
          elif [ -f pyproject.toml ]; then
            pip-audit --path .
          else
            echo "no dependency manifest — SCA skipped"
          fi

  secrets:
    name: secrets
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - name: gitleaks — fail on any leaked secret
        run: |
          curl -sSfL https://github.com/gitleaks/gitleaks/releases/download/v{{ gitleaks_version }}/gitleaks_{{ gitleaks_version }}_linux_x64.tar.gz -o /tmp/gitleaks.tar.gz
          tar -xzf /tmp/gitleaks.tar.gz -C /tmp
          /tmp/gitleaks detect --source . --redact --exit-code 1

  quality:
    name: quality
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
        with:
          python-version: '{{ python_version }}'
      - name: Ruff (E4,E7,E9,F,S,B) + format + mypy
        run: |
          pip install --quiet ruff mypy
          ruff check . --select E4,E7,E9,F,S,B --output-format concise || exit 1
          ruff format --check . || exit 1
          if [ -n "$(find . -name '*.py' -not -path './.git/*' -not -path './venv*/*' -not -path './node_modules/*' | head -1)" ]; then
            mypy --ignore-missing-imports . || exit 1
          fi

  coverage:
    name: coverage
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
        with:
          python-version: '{{ python_version }}'
          cache: pip
      - name: Tests + coverage (enforced on real packages)
        run: |
          pip install --quiet pytest pytest-cov
          [ -f requirements.txt ] && pip install -r requirements.txt || true
          PACKAGES=$(find . -maxdepth 1 -type d \( -name tests -o -name .git -o -name .github -o -name venv -o -name node_modules -o -name scratch \) -prune -o -type d -print | sed 's|^\./||' | grep -v '^\.$' | while read d; do [ -n "$(find "$d" -maxdepth 2 -name '*.py' | head -1)" ] && echo "$d"; done | tr '\n' ' ')
          if [ -z "$PACKAGES" ]; then
            echo "no importable package found — coverage enforcement skipped"
            python -m pytest {{ pytest_path }} -q || exit 1
            exit 0
          fi
          python -m pytest {{ pytest_path }} --cov=$PACKAGES --cov-fail-under={{ coverage_threshold }} --cov-report=term-missing -q

  perf-smoke:
    name: perf-smoke
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
        with:
          python-version: '{{ python_version }}'
      - name: Deterministic perf smoke
        run: |
          pip install --quiet pytest
          [ -f requirements.txt ] && pip install -r requirements.txt || true
          if [ -f {{ perf_test_path }} ]; then
            python -m pytest {{ perf_test_path }} -q
          else
            echo "no {{ perf_test_path }} — perf smoke skipped"
          fi

  semgrep:
    name: semgrep
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
        with:
          python-version: '{{ python_version }}'
      - name: Semgrep (p/security-audit) — fail on findings
        run: |
          pip install --quiet semgrep
          semgrep scan --config p/security-audit --error --quiet --metrics=off .

  container:
    name: container
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - name: Trivy (if Dockerfile exists)
        run: |
          if [ ! -f Dockerfile ]; then
            echo "no Dockerfile — container scan skipped"
            exit 0
          fi
          curl -sSfL https://github.com/aquasecurity/trivy/releases/download/v{{ trivy_version }}/trivy_{{ trivy_version }}_Linux-64bit.tar.gz -o /tmp/trivy.tar.gz
          tar -xzf /tmp/trivy.tar.gz -C /tmp
          /tmp/trivy fs --scanners vuln,secret,misconfig --severity HIGH,CRITICAL --exit-code 1 --ignore-unfixed --skip-dirs node_modules --skip-dirs venv --skip-dirs .git .
{% if codeql_on == 'true' or codeql_on == True %}
  codeql:
    name: codeql
    runs-on: ubuntu-latest
    permissions:
      contents: read
      security-events: write
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - name: Check for code
        id: has_code
        run: |
          if find . -name '*.py' -not -path './.git/*' -not -path './venv*/*' -not -path './node_modules/*' 2>/dev/null | grep -q .; then
            echo "found=true" >> "$GITHUB_OUTPUT"
          else
            echo "found=false" >> "$GITHUB_OUTPUT"
          fi
      - if: steps.has_code.outputs.found == 'true'
        uses: github/codeql-action/init@d6317709a54fd87078d323eeb0e48ec331c8e621 # v3
        with:
          languages: python
      - if: steps.has_code.outputs.found == 'true'
        uses: github/codeql-action/analyze@d6317709a54fd87078d323eeb0e48ec331c8e621 # v3
{% endif %}
  zizmor:
    name: zizmor
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - name: zizmor — audit the repo's own workflows
        run: |
          curl -sSfL https://github.com/woodruffw/zizmor/releases/download/v{{ zizmor_version }}/zizmor-x86_64-unknown-linux-gnu.tar.gz -o /tmp/zizmor.tar.gz
          tar -xzf /tmp/zizmor.tar.gz -C /tmp
          /tmp/zizmor --min-severity medium .
