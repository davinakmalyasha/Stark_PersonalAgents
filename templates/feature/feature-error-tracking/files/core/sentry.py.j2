"""Sentry integration for {{ app_name }} — error tracking + breadcrumbs.

Set SENTRY_DSN in .env. When empty, runs in log-only mode (no external call).
"""
import logging
import os

try:
    import sentry_sdk

    HAS_SENTRY = True
except Exception:
    HAS_SENTRY = False


def init_sentry() -> None:
    dsn = os.environ.get("SENTRY_DSN", "").strip()
    if not dsn or not HAS_SENTRY:
        logging.getLogger(__name__).info("Sentry disabled (no DSN or sdk missing)")
        return
    sentry_sdk.init(
        dsn=dsn,
        traces_sample_rate=0.1,
        send_default_pii=False,
    )
    logging.getLogger(__name__).info("Sentry initialized")


def capture_exception(exc: Exception, **context) -> None:
    if HAS_SENTRY and os.environ.get("SENTRY_DSN"):
        with sentry_sdk.push_scope() as scope:
            for k, v in context.items():
                scope.set_extra(k, v)
            sentry_sdk.capture_exception(exc)
    logging.getLogger(__name__).error(f"Exception captured: {exc}", exc_info=exc)


