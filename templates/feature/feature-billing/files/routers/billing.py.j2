"""Billing endpoints: plans, subscribe, cancel, my invoices."""
from fastapi import APIRouter, Depends, HTTPException, status
from sqlalchemy.orm import Session

from ..core.security import get_current_user
from ..database import get_db
from ..schemas.billing import (
    InvoiceRead,
    PlanCreate,
    PlanRead,
    SubscribeRequest,
    SubscriptionRead,
)
from ..services import billing_service

router = APIRouter(prefix="{{ base_path }}/billing", tags=["billing"])


@router.get("/plans", response_model=list[PlanRead])
def list_plans(db: Session = Depends(get_db)):
    return billing_service.list_plans(db)


@router.post("/plans", response_model=PlanRead, status_code=status.HTTP_201_CREATED)
def create_plan(data: PlanCreate, db: Session = Depends(get_db)):
    # TODO: guard with require_role("admin") from feature-rbac.
    return billing_service.create_plan(db, data, currency="{{ currency }}")


@router.post("/subscribe", response_model=SubscriptionRead)
def subscribe(
    data: SubscribeRequest,
    claims: dict = Depends(get_current_user),
    db: Session = Depends(get_db),
):
    try:
        return billing_service.subscribe(db, int(claims["sub"]), data.plan_code)
    except ValueError as e:
        raise HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=str(e))


@router.post("/cancel", response_model=SubscriptionRead)
def cancel(
    claims: dict = Depends(get_current_user),
    db: Session = Depends(get_db),
):
    sub = billing_service.cancel(db, int(claims["sub"]))
    if sub is None:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND,
                            detail="No active subscription")
    return sub


@router.get("/invoices", response_model=list[InvoiceRead])
def my_invoices(
    claims: dict = Depends(get_current_user),
    db: Session = Depends(get_db),
):
    return billing_service.list_invoices(db, int(claims["sub"]))


