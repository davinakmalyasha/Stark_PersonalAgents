"""In-process task queue worker — threaded, retry with backoff, dead-letter callback."""
import logging
import queue
import threading
import time
import traceback
from typing import Callable, Optional

logger = logging.getLogger("app.queue")


class TaskQueue:
    """Submit callables to worker threads. Retries failed tasks, then dead-letters them."""

    def __init__(self, workers: int = {{ default_workers }}, max_retries: int = 3, backoff: float = 1.0):
        self._queue: "queue.Queue[dict]" = queue.Queue()
        self._workers = [
            threading.Thread(target=self._run, name=f"task-{i}", daemon=True)
            for i in range(workers)
        ]
        self._max_retries = max_retries
        self._backoff = backoff
        self._dead: list = []
        self.on_dead: Optional[Callable[[str, BaseException], None]] = None

    def start(self) -> "TaskQueue":
        for w in self._workers:
            w.start()
        return self

    def submit(self, fn: Callable, *args, **kwargs) -> None:
        self._queue.put({"fn": fn, "args": args, "kwargs": kwargs, "retries": 0})

    def wait(self, timeout: Optional[float] = None) -> None:
        """Block until the queue drains (best-effort with timeout)."""
        deadline = time.monotonic() + timeout if timeout else None
        while not self._queue.empty():
            if deadline and time.monotonic() > deadline:
                return
            time.sleep(0.05)

    def _run(self) -> None:
        while True:
            task = self._queue.get()
            fn = task["fn"]
            try:
                fn(*task["args"], **task["kwargs"])
            except BaseException as e:
                task["retries"] += 1
                if task["retries"] <= self._max_retries:
                    logger.warning("retry %d/%d for %s: %s", task["retries"], self._max_retries, fn.__name__, e)
                    time.sleep(self._backoff * (2 ** (task["retries"] - 1)))
                    self._queue.put(task)
                else:
                    logger.error("task %s failed permanently:\n%s", fn.__name__, traceback.format_exc())
                    self._dead.append(task)
                    if self.on_dead:
                        try:
                            self.on_dead(fn.__name__, e)
                        except Exception:
                            pass
            finally:
                self._queue.task_done()
