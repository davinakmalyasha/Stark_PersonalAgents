"""Notification endpoints: current user's inbox, unread count, read/unread-all."""
from fastapi import APIRouter, Depends, HTTPException, Query, status
from pydantic import BaseModel
from sqlalchemy.orm import Session

from ..core.security import get_current_user
from ..database import get_db
from ..models.notification import Notification
from ..services.notification_service import (
    list_for_user,
    mark_all_read,
    mark_read,
    unread_count,
)

router = APIRouter(prefix="{{ base_path }}/notifications", tags=["notifications"])


class NotificationRead(BaseModel):
    id: int
    title: str
    body: str | None
    is_read: bool
    created_at: str


class NotificationListResponse(BaseModel):
    items: list[NotificationRead]
    total: int
    page: int
    page_size: int
    unread: int


def _to_read(it: Notification) -> NotificationRead:
    return NotificationRead(id=it.id, title=it.title, body=it.body,
                            is_read=it.is_read, created_at=it.created_at.isoformat())


@router.get("", response_model=NotificationListResponse)
def inbox(page: int = Query(1, ge=1), page_size: int = Query(20, ge=1, le=50),
          unread_only: bool = False, claims: dict = Depends(get_current_user),
          db: Session = Depends(get_db)):
    user_id = int(claims["sub"])
    items, total = list_for_user(db, user_id, page=page, page_size=page_size,
                                 unread_only=unread_only)
    return {
        "items": [_to_read(it) for it in items],
        "total": total,
        "page": page,
        "page_size": page_size,
        "unread": unread_count(db, user_id),
    }


@router.get("/unread-count")
def count(claims: dict = Depends(get_current_user), db: Session = Depends(get_db)):
    return {"unread": unread_count(db, int(claims["sub"]))}


@router.post("/{notification_id}/read", status_code=status.HTTP_204_NO_CONTENT)
def read(notification_id: int, claims: dict = Depends(get_current_user),
         db: Session = Depends(get_db)):
    entry = mark_read(db, int(claims["sub"]), notification_id)
    if not entry:
        raise HTTPException(status_code=404, detail="Notification not found")


@router.post("/read-all", status_code=status.HTTP_204_NO_CONTENT)
def read_all(claims: dict = Depends(get_current_user), db: Session = Depends(get_db)):
    mark_all_read(db, int(claims["sub"]))


