"""Generic query-param filtering for list endpoints — search/range/sort on any model."""
from typing import Any, Dict, List, Optional

_OPERATORS = {
    "eq": lambda col, v: col == v,
    "ne": lambda col, v: col != v,
    "gt": lambda col, v: col > v,
    "gte": lambda col, v: col >= v,
    "lt": lambda col, v: col < v,
    "lte": lambda col, v: col <= v,
    "like": lambda col, v: col.ilike(f"%{v}%"),
    "in": lambda col, v: col.in_(str(v).split(",")),
}


def build_filters(params: Dict[str, str], search_fields: Optional[List[str]] = None) -> dict:
    """Parse ?search=, ?field__op=, ?sort= into a normalized filter dict."""
    filters: Dict[str, List[Any]] = {"search": [], "predicates": [], "sort": None}
    for key, value in params.items():
        if not value:
            continue
        if key == "search":
            filters["search"].append(value)
        elif key == "sort":
            field, _, direction = value.partition(":")
            filters["sort"] = (field, direction or "asc")
        elif "__" in key:
            field, op = key.rsplit("__", 1)
            if op in _OPERATORS:
                filters["predicates"].append((field, op, value))
    filters["search_fields"] = search_fields or []
    return filters


def apply_filters(query, filters: dict, sort_fields: Optional[List[str]] = None):
    """Apply the parsed filters to a SQLAlchemy query. Returns the filtered query."""
    model = query.column_descriptions[0]["entity"]
    for term in filters.get("search", []):
        like = f"%{term}%"
        for field in filters.get("search_fields", []):
            query = query.filter(getattr(model, field).ilike(like))
    for field, op, value in filters.get("predicates", []):
        query = query.filter(_OPERATORS[op](getattr(model, field), value))
    sort = filters.get("sort")
    if sort and (sort_fields is None or sort[0] in sort_fields):
        column = getattr(model, sort[0])
        query = query.order_by(column.desc() if sort[1] == "desc" else column.asc())
    return query
