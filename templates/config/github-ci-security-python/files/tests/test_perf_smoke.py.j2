"""Deterministic perf smoke — extend with your app's real budgets.

Runs in the gate's perf-smoke job (tests/test_perf_smoke.py). Keep every
assertion time-bounded so the gate stays deterministic.
"""
import os
import time

import pytest

# Entry module of the app under test — override via PERF_ENTRY_MODULE or edit here.
ENTRY_MODULE = os.environ.get("PERF_ENTRY_MODULE", "app.main")

_app = pytest.importorskip(
    ENTRY_MODULE.split(".")[0],
    reason=f"no '{ENTRY_MODULE.split('.')[0]}' package in this repo — "
           "import-budget test not applicable (set PERF_ENTRY_MODULE to enable)",
)


def test_import_time_budget():
    """Importing the app must stay under 5s (catches dependency bloat early)."""
    import subprocess
    import sys

    start = time.time()
    r = subprocess.run(
        [sys.executable, "-c", f"import {ENTRY_MODULE}"],
        capture_output=True,
        timeout=30,
    )
    elapsed = time.time() - start
    assert r.returncode == 0, f"import failed: {r.stderr.decode()[:300]}"
    assert elapsed < 5.0, f"import took {elapsed:.1f}s (budget 5s)"


