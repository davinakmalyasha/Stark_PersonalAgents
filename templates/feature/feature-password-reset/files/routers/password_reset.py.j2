"""Password reset endpoints: forgot (issue + email) and reset (consume)."""
import os

from fastapi import APIRouter, Depends
from pydantic import BaseModel, Field
from sqlalchemy.orm import Session

from ..database import get_db
from ..services import reset_service

router = APIRouter(prefix="{{ base_path }}/auth", tags=["auth"])


class ForgotPasswordRequest(BaseModel):
    username: str


class ResetPasswordRequest(BaseModel):
    token: str
    new_password: str = Field(min_length=8, max_length=200)


def _send_reset_email(username: str, token: str) -> None:
    """Email the reset link. Falls back to a log line when SMTP is unconfigured."""
    try:
        from ..services.emailer import send_email  # from feature-email
        reset_url = f"{os.environ.get('APP_BASE_URL', 'http://localhost:3000')}/reset-password?token={token}"
        send_email(
            to=username,
            subject="Password reset",
            html=f"<p>Reset your password: <a href='{reset_url}'>link</a></p>",
        )
    except Exception as e:
        # SMTP not configured or feature-email absent — surface the token in logs
        # for local/dev flows. NEVER log the token in production.
        if os.environ.get("APP_ENV", "development") != "production":
            print(f"[password-reset] reset token for '{username}': {token}")
        else:
            print(f"[password-reset] email delivery failed: {e}")


@router.post("/forgot-password", status_code=202)
def forgot_password(data: ForgotPasswordRequest, db: Session = Depends(get_db)):
    """Issue a reset token and email the reset link. Always returns 202."""
    try:
        token = reset_service.issue_reset_token(db, data.username)
    except Exception:
        # Same response whether or not the username exists (no enumeration).
        return {"status": "sent"}
    _send_reset_email(data.username, token)
    return {"status": "sent"}


@router.post("/reset-password", status_code=204)
def reset_password(data: ResetPasswordRequest, db: Session = Depends(get_db)):
    """Consume the token and set the new password. Single-use, 30min TTL."""
    reset_service.consume_reset_token(db, data.token, data.new_password)


