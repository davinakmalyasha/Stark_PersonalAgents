{
  "name": "feature-upload",
  "description": "File upload endpoint: size/type validation, safe storage, static serving wiring.",
  "category": "feature",
  "variables": [
    {"name": "app_name", "type": "string", "default": "app", "description": "Package name, e.g. 'app'"},
    {"name": "upload_dir", "type": "string", "default": "uploads", "description": "Directory for uploaded files"},
    {"name": "max_mb", "type": "string", "default": "10", "description": "Max file size in MB"},
    {"name": "allowed_exts", "type": "string", "default": "png,jpg,jpeg,gif,pdf", "description": "Comma-separated allowed extensions"}
  ],
  "files": [
    {"src": "upload.py.j2", "dest": "{{ app_name }}/routers/upload.py"}
  ],
  "notes": "After applying: register the router, mount static files at /uploads in your app, and point upload_dir at your storage (local, S3, etc. — TODO markers).",
  "sample_vars": {"app_name": "app", "upload_dir": "uploads", "max_mb": "10", "allowed_exts": "png,jpg,jpeg,gif,pdf"}
}
