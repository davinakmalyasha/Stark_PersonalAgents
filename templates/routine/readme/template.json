    {"name": "install_cmd", "type": "string", "default": "pip install -r requirements.txt", "description": "Command to install deps"},
    {"name": "test_cmd", "type": "string", "default": "pytest", "description": "Command to run tests"}
  ],
  "files": [
    {"src": "README.md.j2", "dest": "README.md"}
  ],
  "notes": "Fill the structure section from the real repo layout. This is also the file agents read first — keep it accurate.",
  "sample_vars": {"project_name": "my-api", "description": "FastAPI backend for X", "run_cmd": "uvicorn app.main:app", "install_cmd": "pip install -r requirements.txt", "test_cmd": "pytest"}
