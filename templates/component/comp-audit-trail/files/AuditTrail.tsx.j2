import { useEffect, useState } from "react";

type AuditEntry = { ts: string; actor: string; action: string; resource: string };

export default function AuditTrail({ apiBase = "{{ base_path }}" }: { apiBase?: string }) {
  const [entries, setEntries] = useState<AuditEntry[]>([]);

  useEffect(() => {
    fetch(`${apiBase}/admin/audit`, {
      headers: { Authorization: `Bearer ${localStorage.getItem("auth_token") || ""}` },
    })
      .then((r) => r.json())
      .then((d) => setEntries(d.entries || d.logs || []))
      .catch(() => {});
  }, [apiBase]);

  return (
    <div className="audit-trail">
      <h3>Audit Trail</h3>
      <ul>
        {entries.map((e, i) => (
          <li key={i}>
            <small>{e.ts}</small> <b>{e.actor}</b> {e.action} {e.resource}
          </li>
        ))}
      </ul>
      {entries.length === 0 && <p>No audit entries.</p>}
    </div>
  );
}

