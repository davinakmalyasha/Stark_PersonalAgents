{
  "name": "nginx",
  "description": "Nginx reverse proxy config: serve static frontend + proxy API with security headers.",
  "category": "config",
  "variables": [
    {"name": "server_name", "type": "string", "default": "example.com", "description": "Domain or underscore for default"},
    {"name": "frontend_dir", "type": "string", "default": "/var/www/frontend", "description": "Static frontend root"},
    {"name": "api_upstream", "type": "string", "default": "http://127.0.0.1:8000", "description": "Backend API upstream"},
    {"name": "api_prefix", "type": "string", "default": "/api", "description": "API path prefix to proxy"}
  ],
  "files": [
    {"src": "nginx.conf.j2", "dest": "nginx.conf"}
  ],
  "notes": "Drop into /etc/nginx/conf.d (or use with docker). TODO: add TLS via certbot for production.",
  "sample_vars": {"server_name": "example.com", "frontend_dir": "/var/www/frontend", "api_upstream": "http://127.0.0.1:8000", "api_prefix": "/api"}
}
