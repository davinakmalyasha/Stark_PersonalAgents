import { useForm } from "react-hook-form";

export interface Field {
  name: string;
  label: string;
  type?: "text" | "email" | "password" | "number" | "textarea" | "select";
  options?: { value: string; label: string }[]; // for type="select"
  placeholder?: string;
  rules?: Record<string, any>;
  defaultValue?: string | number;
}

interface Props {
  fields: Field[];
  onSubmit: (values: Record<string, any>) => void | Promise<void>;
  submitLabel?: string;
  loading?: boolean;
}

export default function AppForm({ fields, onSubmit, submitLabel = "Submit", loading }: Props) {
  const {
    register,
    handleSubmit,
    formState: { errors },
  } = useForm({
    defaultValues: Object.fromEntries(fields.map((f) => [f.name, f.defaultValue ?? ""])),
  });

  return (
    <form className="app-form" onSubmit={handleSubmit((values) => onSubmit(values))}>
      {fields.map((field) => (
        <div className="form-group" key={field.name}>
          <label htmlFor={field.name}>{field.label}</label>
          {field.type === "textarea" ? (
            <textarea id={field.name} placeholder={field.placeholder} {...register(field.name, field.rules)} />
          ) : field.type === "select" ? (
            <select id={field.name} {...register(field.name, field.rules)}>
              <option value="">{"\u2014"}</option>
              {(field.options ?? []).map((opt) => (
                <option key={opt.value} value={opt.value}>
                  {opt.label}
                </option>
              ))}
            </select>
          ) : (
            <input
              id={field.name}
              type={field.type ?? "text"}
              placeholder={field.placeholder}
              {...register(field.name, field.rules)}
            />
          )}
          {errors[field.name] ? (
            <span className="form-error">{String(errors[field.name]?.message ?? "Invalid")}</span>
          ) : null}
        </div>
      ))}
      <button type="submit" disabled={loading}>
        {loading ? "Submitting\u2026" : submitLabel}
      </button>
    </form>
  );
}
