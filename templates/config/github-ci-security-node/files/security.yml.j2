name: Security Gate

permissions:
  contents: read

on:
  push:
  pull_request:

concurrency:
  group: gate
  cancel-in-progress: true

jobs:
  sca:
    name: sca
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '{{ node_version }}'
      - name: npm audit (SCA) â€” fail on known CVEs
        run: |
          if [ -f package.json ]; then
            npm install --silent --package-lock-only
            npm audit --audit-level=high
          else
            echo "no package.json â€” SCA skipped"
          fi

  secrets:
    name: secrets
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - name: gitleaks â€” fail on any leaked secret
        run: |
          curl -sSfL https://github.com/gitleaks/gitleaks/releases/download/v{{ gitleaks_version }}/gitleaks_{{ gitleaks_version }}_linux_x64.tar.gz -o /tmp/gitleaks.tar.gz
          tar -xzf /tmp/gitleaks.tar.gz -C /tmp
          /tmp/gitleaks detect --source . --redact --exit-code 1

  quality:
    name: quality
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '{{ node_version }}'
      - name: ESLint + prettier + tsc (each only if configured)
        run: |
          [ -f package.json ] || { echo "no package.json â€” skipped"; exit 0; }
          npm install --silent
          if [ -f eslint.config.js ] || [ -f eslint.config.mjs ] || [ -f eslint.config.cjs ] || ls .eslintrc* >/dev/null 2>&1; then
            npx eslint . --max-warnings=0 || exit 1
          else
            echo "no eslint config â€” eslint skipped (next projects: npm run lint runs next lint)"
          fi
          if [ -f tsconfig.json ]; then
            npx tsc --noEmit || exit 1
          else
            echo "no tsconfig â€” type check skipped"
          fi
          if [ -f .prettierrc ] || [ -f .prettierrc.json ] || [ -f prettier.config.js ] || [ -f prettier.config.mjs ]; then
            npx prettier --check . || exit 1
          else
            echo "no prettier config â€” format skipped"
          fi

  coverage:
    name: coverage
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '{{ node_version }}'
      - name: Tests + coverage (c8 threshold)
        run: |
          [ -f package.json ] || { echo "no package.json â€” skipped"; exit 0; }
          npm install --silent
          if grep -q '"test"' package.json; then
            npx c8 --check-coverage --lines {{ coverage_threshold }} --reporter=text-summary npm test || exit 1
          else
            echo "no test script â€” coverage skipped"
          fi

  bundle:
    name: bundle
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '{{ node_version }}'
      - name: Build + bundle-size budget
        run: |
          [ -f package.json ] || { echo "no package.json â€” skipped"; exit 0; }
          npm install --silent
          if grep -q '"build"' package.json; then
            out=$(mktemp -d)
            npm run build --silent -- --outDir "$out" >/dev/null 2>&1 || { echo "build failed"; exit 1; }
            largest=$(find "$out" -type f -printf '%s\n' | sort -rn | head -1)
            budget=$(( {{ bundle_budget_kb }} * 1024 ))
            if [ -n "$largest" ] && [ "$largest" -gt "$budget" ]; then
              echo "largest asset ${largest}B exceeds budget ${budget}B"
              exit 1
            fi
            echo "largest asset: $(( ${largest:-0} / 1024 ))KB (budget {{ bundle_budget_kb }}KB)"
          else
            echo "no build script â€” bundle check skipped"
          fi

  perf-smoke:
    name: perf-smoke
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4
        with:
          node-version: '{{ node_version }}'
      - name: Main-entry import budget
        run: |
          if [ -f tests/perf-smoke.mjs ]; then
            PERF_IMPORT_BUDGET_MS={{ perf_import_budget_ms }} node tests/perf-smoke.mjs
          else
            echo "no tests/perf-smoke.mjs â€” perf smoke skipped"
          fi

  semgrep:
    name: semgrep
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5
        with:
          python-version: '3.12'
      - name: Semgrep (p/security-audit) â€” fail on findings
        run: |
          pip install --quiet semgrep
          semgrep scan --config p/security-audit --error --quiet --metrics=off .

  container:
    name: container
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - name: Trivy (if Dockerfile exists)
        run: |
          if [ ! -f Dockerfile ]; then
            echo "no Dockerfile â€” container scan skipped"
            exit 0
          fi
          curl -sSfL https://github.com/aquasecurity/trivy/releases/download/v{{ trivy_version }}/trivy_{{ trivy_version }}_Linux-64bit.tar.gz -o /tmp/trivy.tar.gz
          tar -xzf /tmp/trivy.tar.gz -C /tmp
          /tmp/trivy fs --scanners vuln,secret,misconfig --severity HIGH,CRITICAL --exit-code 1 --ignore-unfixed --skip-dirs node_modules --skip-dirs .git .
{% if codeql_on == 'true' or codeql_on == True %}
  codeql:
    name: codeql
    runs-on: ubuntu-latest
    permissions:
      contents: read
      security-events: write
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - name: Check for JS/TS code
        id: has_js
        run: |
          if find . -name '*.js' -o -name '*.jsx' -o -name '*.ts' -o -name '*.tsx' -o -name '*.mjs' -o -name '*.cjs' 2>/dev/null | grep -v node_modules | grep -q .; then
            echo "found=true" >> "$GITHUB_OUTPUT"
          else
            echo "found=false" >> "$GITHUB_OUTPUT"
          fi
      - if: steps.has_js.outputs.found == 'true'
        uses: github/codeql-action/init@d6317709a54fd87078d323eeb0e48ec331c8e621 # v3
        with:
          languages: javascript-typescript
      - if: steps.has_js.outputs.found == 'true'
        uses: github/codeql-action/analyze@d6317709a54fd87078d323eeb0e48ec331c8e621 # v3
{% endif %}
  zizmor:
    name: zizmor
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4
        with:
          persist-credentials: false
      - name: zizmor â€” audit the repo's own workflows
        run: |
          curl -sSfL https://github.com/woodruffw/zizmor/releases/download/v{{ zizmor_version }}/zizmor-x86_64-unknown-linux-gnu.tar.gz -o /tmp/zizmor.tar.gz
          tar -xzf /tmp/zizmor.tar.gz -C /tmp
          /tmp/zizmor --min-severity medium .
