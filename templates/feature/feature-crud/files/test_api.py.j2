"""Tests for the {{ feature_name }} API (service layer mocked)."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from fastapi.testclient import TestClient

from {{ package_dir }}.main import app
from {{ package_dir }}.services import {{ feature_name|lower }}_service

client = TestClient(app)


def test_create_{{ feature_name|lower }}_returns_201(monkeypatch):
    def fake_create(db, data):
        return {"id": 1, **data.model_dump(exclude_none=True)}

    monkeypatch.setattr({{ feature_name|lower }}_service, "create_{{ feature_name|lower }}", fake_create)
    r = client.post("{{ base_path }}/{{ feature_name|lower }}s", json={})
    assert r.status_code == 201
    assert r.json()["id"] == 1


def test_list_{{ feature_name|lower }}_returns_envelope(monkeypatch):
    monkeypatch.setattr({{ feature_name|lower }}_service, "list_{{ feature_name|lower }}",
                        lambda db, page=1, page_size=20, search="", sort="": ([], 0))
    r = client.get("{{ base_path }}/{{ feature_name|lower }}s")
    assert r.status_code == 200
    body = r.json()
    assert body == {"items": [], "total": 0, "page": 1, "page_size": 20}


def test_get_missing_{{ feature_name|lower }}_returns_404(monkeypatch):
    monkeypatch.setattr({{ feature_name|lower }}_service, "get_{{ feature_name|lower }}",
                        lambda db, i: None)
    r = client.get("{{ base_path }}/{{ feature_name|lower }}s/1")
    assert r.status_code == 404


def test_delete_missing_{{ feature_name|lower }}_returns_404(monkeypatch):
    monkeypatch.setattr({{ feature_name|lower }}_service, "get_{{ feature_name|lower }}",
                        lambda db, i: None)
    r = client.delete("{{ base_path }}/{{ feature_name|lower }}s/1")
    assert r.status_code == 404
