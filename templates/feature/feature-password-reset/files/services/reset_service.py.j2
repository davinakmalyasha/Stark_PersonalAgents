"""Password reset service: token issue, verification, single-use consumption."""
import hashlib
import secrets
from datetime import datetime, timedelta

from fastapi import HTTPException
from sqlalchemy.orm import Session

from ..core.security import hash_password
from ..models.reset_token import PasswordResetToken
from ..services import auth_service

_TOKEN_TTL_MINUTES = int("{{ token_ttl_minutes }}")


def _hash(token: str) -> str:
    return hashlib.sha256(token.encode()).hexdigest()


def issue_reset_token(db: Session, username: str) -> str:
    """Create a reset token for a user; return the RAW token (store only its hash).
    Unknown usernames get a 404 (identical to the happy path's other outcomes so
    the endpoint does not leak which usernames exist)."""
    user = auth_service.get_by_username(db, username)
    if not user:
        raise HTTPException(status_code=404, detail="Unknown username")
    raw = secrets.token_urlsafe(32)
    db.add(PasswordResetToken(
        user_id=user.id,
        token_hash=_hash(raw),
        expires_at=datetime.utcnow() + timedelta(minutes=_TOKEN_TTL_MINUTES),
    ))
    db.commit()
    return raw


def consume_reset_token(db: Session, token: str, new_password: str) -> None:
    """Validate + consume the token (single-use) and set the new password."""
    entry = db.query(PasswordResetToken).filter(
        PasswordResetToken.token_hash == _hash(token)).first()
    if not entry or entry.used or entry.is_expired:
        raise HTTPException(status_code=400, detail="Invalid or expired reset token")
    user = auth_service.get_user_by_id(db, entry.user_id)
    if not user:
        raise HTTPException(status_code=400, detail="Invalid or expired reset token")
    entry.used = True
    user.password_hash = hash_password(new_password)
    db.commit()
